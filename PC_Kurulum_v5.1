    # --- WEBSOCKET BAĞLANTI YÖNETİMİ ---
    def start_connection(self):
        cfg = self._sync_runtime_settings()
        self.save_config()
        mode = cfg["conn_mode"]
        ip = cfg["tv_ip"]
        try:
            port = int(cfg["tv_port"])
        except ValueError:
            self.set_status("Hata: Port numarası sadece rakam olmalıdır!", "#ff5252")
            return

        if mode == "client":
            threading.Thread(target=self._connect_as_client, args=(ip, port), daemon=True).start()
        else:
            if self.server_running:
                self.set_status(f"Durum: Sunucu zaten {port} portunda çalışıyor.", "#00e676")
                return
            threading.Thread(target=self._start_ws_server, args=(port,), daemon=True).start()

    def _connect_as_client(self, ip, port):
        url = f"ws://{ip}:{port}"
        self.set_status(f"Durum: {url} adresine bağlanılıyor...", "#29b6f6")
        try:
            if self.ws_client:
                try:
                    self.ws_client.close()
                except Exception:
                    pass
            ws = websocket.WebSocket()
            ws.settimeout(4)
            ws.connect(url)
            ws.settimeout(None)
            self.ws_client = ws
            self.set_status(f"Durum: Toshiba TV'ye Bağlandı! ({url})", "#00e676")
        except Exception as e:
            self.ws_client = None
            self.set_status(f"Bağlantı Hatası: {e}", "#ff5252")

    def _start_ws_server(self, port):
        async def handler(ws):
            self.connected_tv_clients.add(ws)
            self.set_status(f"Durum: TV Sunucuya Bağlandı! ({len(self.connected_tv_clients)} cihaz)", "#00e676")
            try:
                async for _ in ws:
                    pass
            finally:
                self.connected_tv_clients.discard(ws)

        async def main():
            try:
                async with websockets.serve(handler, "0.0.0.0", port):
                    self.server_running = True
                    self.set_status(f"Durum: Sunucu {self._get_local_ip()}:{port} üzerinde TV'yi bekliyor...", "#29b6f6")
                    await asyncio.Future()
            except Exception as e:
                self.server_running = False
                self.set_status(f"Sunucu Başlatma Hatası: {e}", "#ff5252")

        self.server_loop = asyncio.new_event_loop()
        asyncio.set_event_loop(self.server_loop)
        self.server_loop.run_until_complete(main())

    def send_to_tv(self, translated_text, original_text=""):
        cfg = self.runtime_settings
        if cfg.get("data_format", "json") == "json":
            payload = json.dumps({
                "type": "subtitle",
                "text": translated_text,
                "subtitle": translated_text,
                "tr": translated_text,
                "original": original_text,
                "timestamp": int(time.time() * 1000)
            }, ensure_ascii=False)
        else:
            payload = translated_text

        if cfg.get("conn_mode", "client") == "client":
            if self.ws_client:
                try:
                    self.ws_client.send(payload)
                except Exception:
                    self.ws_client = None
            elif (time.time() - self.last_reconnect_attempt) > 10.0:
                self.last_reconnect_attempt = time.time()
                try:
                    ip = cfg.get("tv_ip", "192.168.1.105")
                    port = int(cfg.get("tv_port", "8080"))
                    self._connect_as_client(ip, port)
                    if self.ws_client:
                        self.ws_client.send(payload)
                except Exception:
                    pass

        if self.server_loop and self.connected_tv_clients:
            for client in list(self.connected_tv_clients):
                try:
                    asyncio.run_coroutine_threadsafe(client.send(payload), self.server_loop)
                except Exception:
                    pass

        self.set_preview(translated_text, original_text)

    def send_test_subtitle(self):
        self._sync_runtime_settings()
        test_msg = "OyunÇeviri v5.1 ULTIMATE Bağlantısı Başarılı!"
        self.send_to_tv(test_msg, "Ultimate Engine v5.1 Ready")
        self.set_status("Durum: Test altyazısı TV'ye gönderildi.", "#00e676")

    # --- 2 AŞAMALI OYUN DEYİMLERİ, SÖZLÜK VE DOĞALLAŞTIRMA MOTORU ---
    def _clean_and_normalize_en(self, text, cfg):
        processed = text
        processed = re.sub(r'\|', 'I', processed)
        processed = re.sub(r'[‘’`]', "'", processed)
        processed = re.sub(r'\s+', ' ', processed).strip()

        if cfg.get("idiom_boost", True):
            for pattern, clean_en in EN_IDIOM_NORMALIZER:
                processed = re.sub(pattern, clean_en, processed, flags=re.IGNORECASE)

        return processed

    def _polish_turkish_output(self, tr_text, cfg):
        if not tr_text:
            return ""
        result = tr_text.strip()

        if cfg.get("idiom_boost", True):
            for pattern, natural_tr in TR_NATURAL_POLISHER:
                result = re.sub(pattern, natural_tr, result, flags=re.IGNORECASE)

        glossary = cfg.get("custom_glossary", "")
        if glossary:
            for pair in glossary.split(","):
                if "=" in pair:
                    k, v = pair.split("=", 1)
                    result = re.sub(rf"\b{re.escape(k.strip())}\b", v.strip(), result, flags=re.IGNORECASE)

        return result

    def _translate_local_ollama(self, raw_text, cfg):
        model_name = cfg.get("ollama_model", "gemma2:2b")
        profile_desc = GAME_PROFILES.get(cfg.get("game_profile", ""), "")
        glossary = cfg.get("custom_glossary", "")
        glossary_line = f"Özel Terimler Sözlüğü: {glossary}\n" if glossary else ""
        history_str = "\n".join(self.dialogue_history) if self.dialogue_history else "Yok"

        prompt = (
            f"Görev: Aşağıdaki İngilizce oyun altyazısını profesyonel bir Türkçe oyun yama diliyle çevir.\n"
            f"Oyun Atmosferi: {profile_desc}\n"
            f"{glossary_line}"
            f"Önceki Diyaloglar:\n{history_str}\n"
            f"Kural: SADECE Türkçe çeviriyi yaz, açıklama veya ek bilgi yazma.\n"
            f"Altyazı: {raw_text}"
        )
        try:
            resp = requests.post(
                "http://127.0.0.1:11434/api/generate",
                json={
                    "model": model_name,
                    "prompt": prompt,
                    "stream": False,
                    "options": {"temperature": 0.2, "num_predict": 90}
                },
                timeout=3.2
            )
            if resp.status_code == 200:
                ans = resp.json().get("response", "").strip()
                clean_ans = ans.strip('"').strip("'")
                return self._polish_turkish_output(clean_ans, cfg)
        except Exception:
            pass
        return ""

    def _translate_smart_multi_free(self, text, cfg):
        norm_en = self._clean_and_normalize_en(text, cfg)
        try:
            tr = self.google_translator.translate(norm_en)
            return self._polish_turkish_output(tr, cfg)
        except Exception:
            return ""

    def _translate_offline_argos(self, text, cfg):
        if not ARGOS_AVAILABLE:
            return ""
        try:
            norm_en = self._clean_and_normalize_en(text, cfg)
            tr = argostranslate.translate.translate(norm_en, "en", "tr")
            return self._polish_turkish_output(tr, cfg)
        except Exception:
            return ""

    def _translate_gemini(self, raw_text, client, cfg):
        profile_desc = GAME_PROFILES.get(cfg.get("game_profile", ""), "")
        glossary = cfg.get("custom_glossary", "")
        glossary_line = f"Özel Terimler Sözlüğü: {glossary}\n" if glossary else ""
        history_str = "\n".join(self.dialogue_history) if self.dialogue_history else "Yok"

        prompt = (
            f"Sen profesyonel bir video oyunu yerelleştirme uzmanısın. Atmosfer: {profile_desc}\n"
            f"{glossary_line}"
            f"Önceki Diyalog Geçmişi:\n{history_str}\n"
            f"Aşağıdaki oyun altyazısını en doğal Türkçeye çevir. SADECE çeviriyi ver:\n{raw_text}"
        )
        try:
            response = client.models.generate_content(model="gemini-2.5-flash", contents=prompt)
            return self._polish_turkish_output(response.text.strip(), cfg)
        except Exception as e:
            if "429" in str(e) or "RESOURCE_EXHAUSTED" in str(e):
                self.gemini_cooldown_until = time.time() + 20.0
            return ""

    # --- GÖRÜNTÜ VE OCR DÖNGÜSÜ ---
    def _preprocess_for_ocr(self, img_pil, cfg):
        if not cfg.get("preprocess", True):
            return img_pil
        w, h = img_pil.size
        if h < 90:
            img_pil = img_pil.resize((int(w * 1.5), int(h * 1.5)), Image.Resampling.BICUBIC)
        contrast = ImageEnhance.Contrast(img_pil).enhance(1.4)
        return contrast.filter(ImageFilter.SHARPEN)

    def _is_similar_text(self, text1, text2, threshold=0.86):
        if not text1 or not text2:
            return False
        clean1 = re.sub(r'[^a-zA-Z0-9]', '', text1.lower())
        clean2 = re.sub(r'[^a-zA-Z0-9]', '', text2.lower())
        if clean1 == clean2:
            return True
        return SequenceMatcher(None, clean1, clean2).ratio() >= threshold

    def _frame_diff(self, img_pil):
        small = img_pil.resize((64, 16)).convert("L")
        arr = np.array(small, dtype=np.int16)
        if self.last_img_array is None:
            self.last_img_array = arr
            return 99.0
        diff = float(np.mean(np.abs(arr - self.last_img_array)))
        self.last_img_array = arr
        return diff

    def toggle_capture(self):
        self.save_config()
        if not self.is_running:
            self.is_running = True
            self.btn_toggle.config(text="ÇEVİRİYİ DURDUR", bg="#d50000")
            threading.Thread(target=self.capture_loop, daemon=True).start()
        else:
            self.is_running = False
            self.btn_toggle.config(text="ÇEVİRİYİ BAŞLAT", bg="#00c853")
            self.set_status("Durum: Çeviri durduruldu.", "#9e9e9e")

    def capture_loop(self):
        cfg = self.runtime_settings
        gemini_client = None
        api_key = cfg.get("api_key", "")
        if GEMINI_AVAILABLE and api_key:
            try:
                gemini_client = genai.Client(api_key=api_key)
            except Exception:
                pass

        with mss.mss() as sct:
            while self.is_running:
                start_t = time.time()
                try:
                    roi = cfg.get("roi", self.roi)
                    sct_img = sct.grab(roi)
                    img_pil = Image.frombytes("RGB", sct_img.size, sct_img.bgra, "raw", "BGRX")

                    if self._frame_diff(img_pil) > 3.8:
                        time.sleep(0.14)
                        sct_img = sct.grab(roi)
                        img_pil = Image.frombytes("RGB", sct_img.size, sct_img.bgra, "raw", "BGRX")
                        self._frame_diff(img_pil)
                        self._process_ocr_pipeline(img_pil, gemini_client, cfg)

                except Exception as e:
                    self.set_status(f"Yakalama Hatası: {e}", "#ff5252")

                elapsed = time.time() - start_t
                time.sleep(max(0.26 - elapsed, 0.05))

    def _process_ocr_pipeline(self, img_pil, gemini_client, cfg):
        if not self.ocr_engine:
            self.set_status("Hata: rapidocr-onnxruntime kurulu değil!", "#ff5252")
            return

        proc_img = self._preprocess_for_ocr(img_pil, cfg)
        result, _ = self.ocr_engine(np.array(proc_img))

        if not result:
            self._handle_empty_subtitle(cfg)
            return

        detected_lines = [line[1] for line in result if float(line[2]) > 0.58]
        raw_text = " ".join(detected_lines).strip()

        if len(raw_text) < 2:
            self._handle_empty_subtitle(cfg)
            return

        self.empty_screen_counter = 0
        self.screen_cleared = False

        if self._is_similar_text(raw_text, self.last_raw_text):
            return

        self.last_raw_text = raw_text

        cached_tr = self.db_cache.get(raw_text)
        if cached_tr:
            self.send_to_tv(cached_tr, raw_text)
            self.set_status("Hafızadan Anında Getirildi (0 ms)", "#00e676")
            return

        t0 = time.time()
        mode = cfg.get("engine", "ultimate_hybrid")
        translated = ""
        engine_label = ""

        if mode == "ultimate_hybrid":
            if gemini_client and time.time() >= self.gemini_cooldown_until:
                translated = self._translate_gemini(raw_text, gemini_client, cfg)
                if translated:
                    engine_label = "Gemini 2.5 AI"
            if not translated:
                translated = self._translate_local_ollama(raw_text, cfg)
                if translated:
                    engine_label = "Yerel AI (Ollama)"
            if not translated:
                translated = self._translate_smart_multi_free(raw_text, cfg)
                if translated:
                    engine_label = "Akıllı Deyim Motoru"
            if not translated:
                translated = self._translate_offline_argos(raw_text, cfg)
                if translated:
                    engine_label = "%100 Offline Argos"

        elif mode == "local_ollama_ai":
            translated = self._translate_local_ollama(raw_text, cfg)
            if translated:
                engine_label = "Yerel AI (Ollama)"
            else:
                translated = self._translate_smart_multi_free(raw_text, cfg) or self._translate_offline_argos(raw_text, cfg)
                engine_label = "Yedek Deyim Motoru (Ollama Kapalı)"

        elif mode == "offline_argos":
            translated = self._translate_offline_argos(raw_text, cfg)
            if translated:
                engine_label = "%100 Offline Argos"
            else:
                translated = self._translate_smart_multi_free(raw_text, cfg)
                engine_label = "Akıllı Deyim Motoru (Argos Paketi Yok)"

        else:
            translated = self._translate_smart_multi_free(raw_text, cfg)
            if translated:
                engine_label = "Akıllı Deyim Motoru"
            else:
                translated = self._translate_offline_argos(raw_text, cfg)
                engine_label = "%100 Offline Argos (İnternet Yedeği)"

        if translated:
            ms = int((time.time() - t0) * 1000)
            self.db_cache.set(raw_text, translated)
            self.dialogue_history.append(f"EN: {raw_text} -> TR: {translated}")
            self.send_to_tv(translated, raw_text)
            self.set_status(f"[{engine_label}] Çevrildi ({ms} ms)", "#00e676")

    def _handle_empty_subtitle(self, cfg):
        if not cfg.get("auto_clear", True) or self.screen_cleared:
            return
        self.empty_screen_counter += 1
        if self.empty_screen_counter >= 3:
            self.send_to_tv("", "")
            self.last_raw_text = ""
            self.screen_cleared = True
            self.set_status("Durum: Konuşma bitti, TV ekranı temizlendi.", "#9e9e9e")


if __name__ == "__main__":
    root = tk.Tk()
    app = OyunCeviriUltimate(root)
    root.mainloop()
