class PersistentCache:
    def __init__(self, db_path=CACHE_DB_FILE):
        self.db_path = db_path
        self._init_db()

    def _init_db(self):
        with sqlite3.connect(self.db_path) as conn:
            conn.execute("CREATE TABLE IF NOT EXISTS cache (src TEXT PRIMARY KEY, tr TEXT)")

    def get(self, src):
        try:
            with sqlite3.connect(self.db_path) as conn:
                cur = conn.execute("SELECT tr FROM cache WHERE src = ?", (src,))
                row = cur.fetchone()
                return row[0] if row else None
        except Exception:
            return None

    def set(self, src, tr):
        try:
            with sqlite3.connect(self.db_path) as conn:
                conn.execute("INSERT OR REPLACE INTO cache (src, tr) VALUES (?, ?)", (src, tr))
        except Exception:
            pass


class AreaSelector(tk.Toplevel):
    def __init__(self, parent, callback):
        super().__init__(parent)
        self.callback = callback
        self.attributes("-alpha", 0.35)
        self.attributes("-fullscreen", True)
        self.attributes("-topmost", True)
        self.config(cursor="cross")

        self.canvas = tk.Canvas(self, cursor="cross", bg="black")
        self.canvas.pack(fill="both", expand=True)

        self.start_x = None
        self.start_y = None
        self.rect = None

        self.canvas.bind("<ButtonPress-1>", self.on_press)
        self.canvas.bind("<B1-Motion>", self.on_drag)
        self.canvas.bind("<ButtonRelease-1>", self.on_release)
        self.bind("<Escape>", lambda e: self.destroy())

    def on_press(self, event):
        self.start_x = int(self.canvas.canvasx(event.x))
        self.start_y = int(self.canvas.canvasy(event.y))
        self.rect = self.canvas.create_rectangle(
            self.start_x, self.start_y, self.start_x, self.start_y,
            outline="#00e676", width=3
        )

    def on_drag(self, event):
        cur_x = int(self.canvas.canvasx(event.x))
        cur_y = int(self.canvas.canvasy(event.y))
        self.canvas.coords(self.rect, self.start_x, self.start_y, cur_x, cur_y)

    def on_release(self, event):
        end_x = int(self.canvas.canvasx(event.x))
        end_y = int(self.canvas.canvasy(event.y))
        x1 = min(self.start_x, end_x)
        y1 = min(self.start_y, end_y)
        x2 = max(self.start_x, end_x)
        y2 = max(self.start_y, end_y)

        self.destroy()
        if (x2 - x1) > 20 and (y2 - y1) > 10:
            self.callback({"left": x1, "top": y1, "width": x2 - x1, "height": y2 - y1})


class OyunCeviriUltimate:
    def __init__(self, root):
        self.root = root
        self.root.title("OyunÇeviri v5.1 ULTIMATE - Kusursuz Yerelleştirme Sürümü")
        self.root.geometry("680x860")
        self.root.configure(bg="#121212")

        self.config = self.load_config()
        self.roi = self.config.get("roi", {"left": 300, "top": 800, "width": 1300, "height": 200})

        self.is_running = False
        self.ws_client = None
        self.last_reconnect_attempt = 0.0
        self.server_loop = None
        self.server_running = False
        self.connected_tv_clients = set()

        self.last_raw_text = ""
        self.last_img_array = None
        self.empty_screen_counter = 0
        self.screen_cleared = True
        self.gemini_cooldown_until = 0.0
        self.dialogue_history = deque(maxlen=6)
        self.db_cache = PersistentCache()
        self.runtime_settings = {}

        self.ocr_engine = RapidOCR() if OCR_AVAILABLE else None
        self.google_translator = GoogleTranslator(source="auto", target="tr")

        self._build_ui()
        self._sync_runtime_settings()
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    def set_status(self, text, color="#9e9e9e"):
        self.root.after(0, lambda: self.lbl_status.config(text=text, fg=color))

    def set_preview(self, translated_text, original_text=""):
        def _update():
            self.txt_preview.delete("1.0", tk.END)
            if translated_text:
                display_str = f"[TR]: {translated_text}\n[EN]: {original_text}" if original_text else translated_text
                self.txt_preview.insert(tk.END, display_str)
        self.root.after(0, _update)

    def load_config(self):
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                pass
        return {}

    def _sync_runtime_settings(self):
        glossary_val = self.entry_glossary.get().strip()
        if glossary_val == DEFAULT_GLOSSARY_HINT:
            glossary_val = ""
        self.runtime_settings = {
            "tv_ip": self.entry_ip.get().strip(),
            "tv_port": self.entry_port.get().strip(),
            "conn_mode": self.conn_mode.get(),
            "data_format": self.format_var.get(),
            "engine": self.engine_var.get(),
            "ollama_model": self.ollama_model_var.get().strip() or "gemma2:2b",
            "game_profile": self.profile_var.get(),
            "api_key": self.entry_api.get().strip(),
            "custom_glossary": glossary_val,
            "auto_clear": bool(self.auto_clear_var.get()),
            "preprocess": bool(self.preprocess_var.get()),
            "idiom_boost": bool(self.idiom_var.get()),
            "roi": dict(self.roi)
        }
        return self.runtime_settings

    def save_config(self):
        data = self._sync_runtime_settings()
        try:
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
        except Exception:
            pass

    def on_close(self):
        self.is_running = False
        self.save_config()
        if self.ws_client:
            try:
                self.ws_client.close()
            except Exception:
                pass
        self.root.destroy()

    def _get_local_ip(self):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            ip = s.getsockname()[0]
            s.close()
            return ip
        except Exception:
            return "127.0.0.1"

